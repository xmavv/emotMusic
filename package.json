  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref amcjwngnvmykiiljosuu",
    "db:pull": "supabase db pull --remote",
