    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote --schema public > services/supabase/database.types.ts",
    "db:seed:dump": "supabase db dump --remote --data-only --schema public -f supabase/seed.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
