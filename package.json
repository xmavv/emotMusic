{
  "name": "music-my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref amcjwngnvmykiiljosuu",
    "db:pull": "supabase db pull --remote",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --schema public | prettier --stdin-filepath services/supabase/database.types.ts > services/supabase/database.types.ts",
    "db:types:remote": "supabase gen types typescript --remote --schema public | prettier --stdin-filepath services/supabase/database.types.ts > services/supabase/database.types.ts",
    "db:lint": "supabase db lint --fail-on error",
    "db:advisors": "supabase db advisors --fail-on warn",
    "db:seed:dump": "supabase db dump --remote --data-only --schema public -f supabase/seed.sql",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
